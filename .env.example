APP_NAME="ÉLITE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Belgrade
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elite_watches
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CONCIERGE_NOTIFICATION_EMAIL=admin@elite.com
CONCIERGE_SLA_HOURS=24
CONCIERGE_PUBLIC_EMAIL=
CONCIERGE_PUBLIC_PHONE=
CONCIERGE_STREET=
CONCIERGE_DISTRICT=
CONCIERGE_CITY=

# Settlement details sent to clients on approval — set real values before going live.
CONCIERGE_WIRE_BENEFICIARY=
CONCIERGE_WIRE_BANK=
CONCIERGE_WIRE_IBAN=
CONCIERGE_WIRE_BIC=
CONCIERGE_BOUTIQUE_ADDRESS=
CONCIERGE_BOUTIQUE_HOURS=
CONCIERGE_APPOINTMENT_URL=
CONCIERGE_WALLET_BTC=
CONCIERGE_WALLET_ETH=
CONCIERGE_WALLET_USDT=

VITE_APP_NAME="${APP_NAME}"
